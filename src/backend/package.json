{
  "name": "kerni-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de Kerni: harness del agente que cuida la salud de la PC",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "probar-llm": "node --env-file-if-exists=.env scripts/probar-llm.js",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
