# Puerto y host. Por defecto solo escucha en esta máquina.
PORT=8788
HOST=127.0.0.1

# ---- Cerebro (modelo de lenguaje) -------------------------------------------
# Hace falta UNA de estas tres llaves. Solo viven aquí: la app nunca las ve.
#
# Qué proveedor usar: anthropic | gemini | openrouter.
# Vacío = el primero que tenga llave, en ese orden.
LLM_PROVIDER=gemini

# Anthropic (Claude directo)
ANTHROPIC_API_KEY=
# Modelo; por defecto claude-haiku-5-5 (barato y rápido).
KERNI_MODEL=

# Google Gemini (https://aistudio.google.com/apikey)
# OJO: el plan GRATUITO permite solo ~20 pedidos por día por modelo (cada mensaje del chat gasta 1 o 2).
# Para uso real, activá la facturación en AI Studio.
GEMINI_API_KEY=
# Modelo; por defecto gemini-3.6-flash. OJO: gemini-3.8-flash y gemini-3.5-flash-lite fueron lentos
# (35-55 s) o dieron 503 al probarlos; verificá con `npm run probar-llm` antes de cambiarlo.
GEMINI_MODEL=
# Opcional: esfuerzo de razonamiento. No todos los modelos aceptan todos los valores
# (gemini-3.8-flash rechaza "minimal" con un 400). Dejalo vacío salvo que lo necesites.
GEMINI_REASONING_EFFORT=
# Opcional: tiempo máximo por intento en milisegundos (45000 por defecto; se reintenta una vez).
GEMINI_TIMEOUT_MS=

# OpenRouter (https://openrouter.ai/keys): una llave para muchos modelos
OPENROUTER_API_KEY=
# Modelo con el formato proveedor/modelo; por defecto anthropic/claude-haiku-4.5.
OPENROUTER_MODEL=

# Opcional: otra URL para Gemini u OpenRouter (un proxy, o un servidor falso para pruebas).
# Es la URL completa de /chat/completions.
GEMINI_BASE_URL=
OPENROUTER_BASE_URL=

# ---- Límites de uso por persona ---------------------------------------------
TURNOS_POR_MINUTO=20
TURNOS_POR_DIA=300
