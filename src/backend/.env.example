# Puerto y host. Por defecto solo escucha en esta máquina.
PORT=8788
HOST=127.0.0.1

# ---- Cerebro (modelo de lenguaje) -------------------------------------------
# Hace falta UNA de estas tres llaves. Solo viven aquí: la app nunca las ve.
#
# Qué proveedor usar: anthropic | gemini | openrouter.
# Vacío = el primero que tenga llave, en ese orden.
LLM_PROVIDER=gemini

# Anthropic (Claude directo)
ANTHROPIC_API_KEY=
# Modelo; por defecto claude-haiku-5-5 (barato y rápido).
KERNI_MODEL=

# Google Gemini (https://aistudio.google.com/apikey)
# OJO: el plan GRATUITO permite solo ~20 pedidos por día por modelo (cada mensaje del chat gasta 1 o 2).
# Para uso real, activá la facturación en AI Studio.
GEMINI_API_KEY=
# Modelo; por defecto gemini-3.6-flash. OJO: gemini-3.8-flash y gemini-3.5-flash-lite fueron lentos
# (35-55 s) o dieron 503 al probarlos; verificá con `npm run probar-llm` antes de cambiarlo.
GEMINI_MODEL=
# Opcional: esfuerzo de razonamiento. No todos los modelos aceptan todos los valores
# (gemini-3.8-flash rechaza "minimal" con un 400). Dejalo vacío salvo que lo necesites.
GEMINI_REASONING_EFFORT=
# Opcional: tiempo máximo por intento en milisegundos (45000 por defecto; se reintenta una vez).
GEMINI_TIMEOUT_MS=

# OpenRouter (https://openrouter.ai/keys): una llave para muchos modelos
OPENROUTER_API_KEY=
# Modelo con el formato proveedor/modelo; por defecto anthropic/claude-haiku-4.5.
OPENROUTER_MODEL=

# Opcional: otra URL para Gemini u OpenRouter (un proxy, o un servidor falso para pruebas).
# Es la URL completa de /chat/completions.
GEMINI_BASE_URL=
OPENROUTER_BASE_URL=

# ---- Supabase (opcional) ------------------------------------------------------
# La memoria vive en SQLite local y no necesita nada de esto. Supabase solo guarda una copia de la salud
# y aloja la base de conocimiento del RAG. Sin estas dos variables Kerni funciona igual, sin RAG.
# Sin proyecto de Supabase: `node supabase/local/preparar.mjs` y Docker (ver supabase/local/README.md) llenan estas dos variables solos.
# 1) Con la nube: creá un proyecto en https://supabase.com y corré supabase/migrations/*.sql en el SQL Editor.
# 2) Pegá la URL del proyecto y la llave SECRETA (Project Settings > API Keys > secret, o service_role).
#    Es de solo servidor: nunca va en la app ni en el repo. Las tablas tienen RLS sin políticas.
# 3) Verificá con `npm run probar-memoria`.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---- Conocimiento (RAG con pgvector) -----------------------------------------
# Necesita Supabase (arriba) + la migración 20261021000100_rag.sql + una llave de embeddings.
# Usa la de Gemini u OpenRouter que ya tengas. Después: `npm run indexar` y `npm run indexar -- --buscar "..."`.
# Proveedor: gemini | openrouter. Vacío = el de la primera llave que haya.
EMBEDDINGS_PROVIDER=
# Modelo; por defecto gemini-embedding-001 (Gemini) u openai/text-embedding-3-small (OpenRouter).
EMBEDDINGS_MODEL=
# Debe coincidir con vector(768) de la migración. Si lo cambiás, cambiá la migración y reindexá todo.
EMBEDDINGS_DIMENSIONS=768
EMBEDDINGS_BASE_URL=

# ---- Revisión de enlaces (opcional) ------------------------------------------
# "¿Es seguro este enlace?" siempre revisa la dirección (HTTP, IP, acortadores, marcas imitadas...) sin abrir el sitio.
# Con una llave gratuita de Google Safe Browsing también consulta su lista de sitios peligrosos
# (https://developers.google.com/safe-browsing/v4/get-started; se envía la dirección a Google, nada más).
SAFE_BROWSING_API_KEY=

# ---- Límites de uso por persona ---------------------------------------------
TURNOS_POR_MINUTO=20
TURNOS_POR_DIA=300
